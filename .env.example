ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional - a second, different password that signs in with elevated
# "admin" access (deleting requests/companies/locations, wiping history).
# Without this set, nobody gets admin access - only day-to-day staff login.
SUPER_ADMIN_PASSWORD=

# Optional - enables the Locations map. See README "Map setup".
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
