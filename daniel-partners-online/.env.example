# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-long-random-string

# Where the SQLite file and uploaded documents live. Defaults to ./data
DATA_DIR=

# Sandbox only: the password the seeded demo accounts sign in with.
# Change it before letting anyone outside the firm into the sandbox.
SANDBOX_PASSWORD=Sandbox2026!

# Public URL of the main firm website that this app links back to.
NEXT_PUBLIC_FIRM_SITE_URL=https://niagaralaw.ca
